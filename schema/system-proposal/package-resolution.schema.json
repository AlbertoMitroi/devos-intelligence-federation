{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlbertoMitroi/devos-intelligence-federation/schema/system-proposal/package-resolution.schema.json",
  "title": "Package resolution (graph/packages.ndjson)",
  "type": "object",
  "required": ["id", "recordType", "ecosystem", "packageId", "version", "consumer", "producer", "resolution", "versionMatch", "entities"],
  "properties": {
    "id": { "type": "string", "pattern": "^pkr:[0-9a-f]{32}$" },
    "recordType": { "const": "packageResolution" },
    "ecosystem": { "enum": ["nuget", "npm"] },
    "consumer": { "type": "object", "required": ["input", "projects"] },
    "producer": {
      "type": "object",
      "required": ["input", "project", "method", "packageVersion", "repository", "commit"],
      "properties": { "method": { "enum": ["packageId", "assemblyName", "npmName"] } }
    },
    "resolution": { "enum": ["exact", "ambiguous", "candidate", "unresolved"] },
    "versionMatch": { "enum": ["exact", "different", "unknown"] },
    "entities": { "type": "object", "required": ["used", "resolved", "missing"] }
  },
  "additionalProperties": true
}
