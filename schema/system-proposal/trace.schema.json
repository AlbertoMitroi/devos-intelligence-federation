{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlbertoMitroi/devos-intelligence-federation/schema/system-proposal/trace.schema.json",
  "title": "Trace (graph/traces.ndjson)",
  "type": "object",
  "required": ["id", "recordType", "start", "end", "inputs", "links", "segments", "resolution", "weakest"],
  "properties": {
    "id": { "type": "string", "pattern": "^trc:[0-9a-f]{32}$" },
    "recordType": { "const": "trace" },
    "links": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^lnk:[0-9a-f]{32}$" } },
    "segments": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["type", "kind", "resolution", "evidence"],
        "properties": {
          "type": { "enum": ["link", "inside"] },
          "resolution": { "enum": ["exact", "ambiguous", "candidate", "unresolved"] }
        }
      }
    },
    "resolution": { "enum": ["exact", "ambiguous", "candidate", "unresolved"] },
    "weakest": { "type": "object", "required": ["segment", "resolution"] }
  },
  "additionalProperties": true
}
