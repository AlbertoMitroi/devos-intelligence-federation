{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlbertoMitroi/devos-intelligence-federation/schema/system-proposal/system-link.schema.json",
  "title": "System link (graph/links.ndjson records with scope: system; in addition to link.schema.json)",
  "type": "object",
  "required": ["id", "kind", "via", "scope", "from", "to", "resolution", "evidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^lnk:[0-9a-f]{32}$" },
    "scope": { "const": "system" },
    "kind": { "enum": ["configured_route", "consumes_contract", "pushes_to", "implemented_by_package", "possible_communication", "dispatches_to"] },
    "from": {
      "type": "object",
      "required": ["input", "observation", "kind", "project", "entity"],
      "properties": { "input": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } }
    },
    "to": {
      "type": ["object", "null"],
      "required": ["input", "observation", "kind", "project", "entity"],
      "properties": { "input": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } }
    },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/ev:[0-9a-f]{32}$" } }
  },
  "additionalProperties": true
}
